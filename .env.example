# SLAPPZ LOCATOR — ENVIRONMENT
#
# Every variable here is OPTIONAL. The locator runs with no configuration at all:
# the map needs no API key, and geocoding uses a local NYC table with a free fallback.
# Copy to `.env.local` only when you need one of these.

# Canonical origin. Used for metadata, sitemap.xml, robots.txt and OG tags.
# Defaults to https://slappz.nyc
NEXT_PUBLIC_SITE_URL=https://slappz.nyc

# Password for /admin (HTTP Basic — any username, this password).
# Unset in development  -> admin is open locally.
# Unset in production   -> admin returns 503, because an open admin is worse than none.
# Replace with real auth before this carries real traffic. See src/proxy.ts.
SLAPPZ_ADMIN_PASSWORD=

# Storage adapter for retailer overrides and demand signals.
#   (unset)  -> auto: JSON files locally, in-memory on serverless hosts (Vercel/Netlify),
#               which have a read-only filesystem and would otherwise 500 on the first write
#   file     -> force JSON files under ./.data (needs a writable filesystem)
#   memory   -> force in-process; does NOT survive a cold start
# In-memory is fine for a preview deploy. Before this carries real traffic, write the
# Postgres/Supabase adapter — see src/lib/repository/storage.ts.
SLAPPZ_STORE=
